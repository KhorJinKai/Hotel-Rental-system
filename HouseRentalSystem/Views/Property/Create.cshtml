@model HouseRentalSystem.Models.Property
@{
    ViewData["Title"] = "List a new property";
    var categories = ViewBag.Categories as List<HouseRentalSystem.Models.PropertyCategory>;
    var amenities = ViewBag.Amenities as List<HouseRentalSystem.Models.Amenity>;
}

<div class="container page-section" style="max-width:780px;">

    <div class="results-head">
        <div>
            <h1>List a new property</h1>
            <span class="result-count">Listings are free. You keep 100% of the rent — RentEasy charges no commission.</span>
        </div>
        <a class="btn-outline" asp-controller="Property" asp-action="MyListings">Back to my listings</a>
    </div>

    <div class="checkout-card">
        <form asp-controller="Property" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-row">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" placeholder="e.g. Cozy studio near city center" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="Description">Description</label>
                <textarea asp-for="Description" rows="5" placeholder="Describe the property, nearby amenities, house rules, etc."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <div class="field-hint">Maximum 1000 characters.</div>
            </div>

            <div class="form-row">
                <label asp-for="Address">Address</label>
                <input asp-for="Address" placeholder="Street address" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="City">City</label>
                <input asp-for="City" placeholder="e.g. Kuala Lumpur" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="CategoryID">Property type</label>
                <select asp-for="CategoryID">
                    <option value="">Select a type</option>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryID">@cat.CategoryName</option>
                        }
                    }
                </select>
                <span asp-validation-for="CategoryID" class="text-danger"></span>
            </div>

            <div class="form-grid-2">
                <div class="form-row">
                    <label asp-for="NumBedrooms">Bedrooms</label>
                    <input asp-for="NumBedrooms" type="number" min="0" max="20" />
                    <span asp-validation-for="NumBedrooms" class="text-danger"></span>
                </div>
                <div class="form-row">
                    <label asp-for="NumBathrooms">Bathrooms</label>
                    <input asp-for="NumBathrooms" type="number" min="0" max="20" />
                    <span asp-validation-for="NumBathrooms" class="text-danger"></span>
                </div>
            </div>

            <div class="form-grid-2">
                <div class="form-row">
                    <label asp-for="RentPrice">Monthly rent (RM)</label>
                    <input asp-for="RentPrice" type="number" min="0" max="100000" step="0.01" />
                    <span asp-validation-for="RentPrice" class="text-danger"></span>
                </div>
                <div class="form-row">
                    <label asp-for="Deposit">Security deposit (RM)</label>
                    <input asp-for="Deposit" type="number" min="0" step="0.01" />
                    <span asp-validation-for="Deposit" class="text-danger"></span>
                    <div class="field-hint">Most owners set this to two months' rent.</div>
                </div>
            </div>

            @if (amenities != null && amenities.Any())
            {
                <div class="form-row">
                    <label>Facilities &amp; amenities</label>
                    <div class="field-hint" style="margin:0 0 8px;">
                        These become the searchable facility filters tenants use on the results page.
                    </div>
                    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:0 16px;">
                        @foreach (var amenity in amenities)
                        {
                            <label class="check-row">
                                <input type="checkbox" name="selectedAmenities" value="@amenity.AmenityID" /> @amenity.AmenityName
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="form-row">
                <label for="photos">Photos</label>
                <input type="file" id="photos" name="photos" accept="image/*" multiple />
                <div class="field-hint">You can select multiple images. The first one will be used as the main photo.</div>
            </div>

            <button type="submit" class="btn-primary">List property</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

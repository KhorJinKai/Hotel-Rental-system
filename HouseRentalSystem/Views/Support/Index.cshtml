@model List<HouseRentalSystem.Models.SupportTicket>
@using HouseRentalSystem.Models
@{
    ViewData["Title"] = "My tickets";

    string StatusClass(TicketStatus s) => s == TicketStatus.Closed ? "status-neutral" : "status-pending";
}

<div class="container page-section" style="max-width:760px;">

    <div class="results-head">
        <div>
            <h1>My tickets</h1>
            <span class="result-count">@Model.Count ticket@(Model.Count == 1 ? "" : "s")</span>
        </div>
        <a class="btn-primary" style="margin-top:0;" asp-controller="Support" asp-action="Create">Contact support</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="icon">&#128172;</div>
            <h3>No support tickets yet</h3>
            <p>Have a question or an issue? We're here 9am to 7pm daily.</p>
            <a class="btn-outline" asp-controller="Support" asp-action="Create">Contact support</a>
        </div>
    }

    @foreach (var ticket in Model)
    {
        var last = ticket.Messages.OrderByDescending(m => m.SentDate).ThenByDescending(m => m.MessageID).FirstOrDefault();
        <a class="checkout-card" style="display:block; margin-bottom:14px; text-decoration:none;"
           asp-controller="Support" asp-action="Details" asp-route-id="@ticket.TicketID">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                <div>
                    <div style="font-size:15px; font-weight:700; color:var(--text-primary);">@ticket.Subject</div>
                    <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                        Ticket #@ticket.TicketID &middot; @ticket.Messages.Count message@(ticket.Messages.Count == 1 ? "" : "s")
                    </div>
                </div>
                <span class="status-pill @StatusClass(ticket.Status)">@ticket.Status</span>
            </div>
            @if (last != null)
            {
                <p style="margin:10px 0 0; font-size:13px; color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    @(last.Sender == MessageSender.Admin ? "Support: " : last.Sender == MessageSender.Bot ? "Bot: " : "")@last.Body
                </p>
            }
            <div style="margin-top:8px; font-size:11.5px; color:var(--text-muted);">
                Last activity @ticket.LastMessageDate.ToString("d MMM yyyy, h:mm tt")
            </div>
        </a>
    }
</div>

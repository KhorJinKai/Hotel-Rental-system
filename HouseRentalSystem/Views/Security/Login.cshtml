@model HouseRentalSystem.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="container page-section" style="max-width:440px;">
    <div class="checkout-card">
        <h1 style="font-size:21px; margin:0 0 4px; text-align:center;">Sign in to Rent<span style="color:var(--cta);">Easy</span></h1>
        <p style="font-size:13px; color:var(--text-secondary); text-align:center; margin:0 0 22px;">
            Browse, book, and manage your rentals in one place.
        </p>

        @if (TempData["RegisterSuccess"] != null)
        {
            <div class="toast" style="margin:0 0 16px; background:var(--accent-value-bg); border-color:#B9E3D5; color:var(--accent-value);">
                <span class="toast-icon">&#10003;</span> @TempData["RegisterSuccess"]
            </div>
        }

        <form asp-controller="Security" asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-row">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" placeholder="name@example.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" placeholder="Your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <p style="text-align:right; font-size:12.5px; margin:-8px 0 16px;">
                <a asp-controller="Security" asp-action="ForgotPassword">Forgot password?</a>
            </p>

            <button type="submit" class="btn-primary">Sign in</button>
        </form>

        <p style="text-align:center; font-size:13px; margin-top:18px; color:var(--text-secondary);">
            New to RentEasy? <a asp-controller="Security" asp-action="Register">Create an account</a>
        </p>
    </div>

    <ul class="panel-perks" style="margin-top:18px; text-align:center;">
        <li style="justify-content:center;"><span class="tick">&#10003;</span> Free to browse and apply</li>
        <li style="justify-content:center;"><span class="tick">&#10003;</span> Your details are only shared with the owner you apply to</li>
    </ul>
</div>


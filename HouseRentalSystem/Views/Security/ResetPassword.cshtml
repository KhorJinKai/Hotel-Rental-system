@model HouseRentalSystem.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="container page-section" style="max-width:440px;">
    <div class="checkout-card">
        <h1 style="font-size:21px; margin:0 0 4px; text-align:center;">Choose a new password</h1>
        <p style="font-size:13px; color:var(--text-secondary); text-align:center; margin:0 0 22px;">
            Resetting the password for <strong>@Model.Email</strong>.
        </p>

        <form asp-controller="Security" asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="form-row">
                <label asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" placeholder="At least 8 characters" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" placeholder="Re-enter your new password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">Reset password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

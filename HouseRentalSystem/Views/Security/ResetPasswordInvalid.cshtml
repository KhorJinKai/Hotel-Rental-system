@{
    ViewData["Title"] = "Link expired";
}

<div class="container page-section" style="max-width:440px;">
    <div class="checkout-card" style="text-align:center;">
        <h1 style="font-size:21px; margin:0 0 4px;">This link has expired</h1>
        <p style="font-size:13px; color:var(--text-secondary); margin:0 0 4px;">
            Password reset links are only valid for 30 minutes, and can only be used once.
            Request a new one below.
        </p>

        <a class="btn-primary" style="display:inline-block; margin-top:16px;" asp-controller="Security" asp-action="ForgotPassword">Send a new link</a>

        <p style="text-align:center; font-size:13px; margin-top:18px; color:var(--text-secondary);">
            <a asp-controller="Security" asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>

@model HouseRentalSystem.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="container page-section" style="max-width:440px;">
    <div class="checkout-card">
        <h1 style="font-size:21px; margin:0 0 4px; text-align:center;">Forgot your password?</h1>
        <p style="font-size:13px; color:var(--text-secondary); text-align:center; margin:0 0 22px;">
            Enter the email on your account and we'll send you a link to reset it.
        </p>

        <form asp-controller="Security" asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" placeholder="name@example.com" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="Captcha">Verification</label>
                <div class="captcha-row">
                    <img id="captchaImage" class="captcha-image" src="@Url.Action("Image", "Captcha")"
                         width="170" height="56" alt="Characters to type into the box below" />
                    <button type="button" id="captchaReload" class="captcha-reload"
                            title="Get a new image" aria-label="Get a new image">&#8635;</button>
                </div>
                <input asp-for="Captcha" placeholder="Type the characters above"
                       autocomplete="off" autocapitalize="characters" spellcheck="false" />
                <span asp-validation-for="Captcha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">Send reset link</button>
        </form>

        <p style="text-align:center; font-size:13px; margin-top:18px; color:var(--text-secondary);">
            <a asp-controller="Security" asp-action="Login">Back to sign in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model HouseRentalSystem.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="container page-section" style="max-width:480px;">

    <div class="results-head">
        <div>
            <h1>Change password</h1>
            <span class="result-count">We've emailed a verification code to confirm it's really you.</span>
        </div>
        <a class="btn-outline" asp-controller="Profile" asp-action="Index">Back to profile</a>
    </div>

    <div class="checkout-card">
        <form asp-controller="Profile" asp-action="ChangePassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-row">
                <label asp-for="Code">Verification code</label>
                <input asp-for="Code" placeholder="123456" autocomplete="one-time-code" />
                <span asp-validation-for="Code" class="text-danger"></span>
                <div class="field-hint">The code expires 15 minutes after it's sent.</div>
            </div>

            <div class="form-row">
                <label asp-for="NewPassword">New password</label>
                <input asp-for="NewPassword" placeholder="At least 8 characters" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-row">
                <label asp-for="ConfirmPassword">Confirm new password</label>
                <input asp-for="ConfirmPassword" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary">Change password</button>
        </form>

        <form asp-controller="Profile" asp-action="ResendPasswordChangeCode" method="post" style="margin-top:12px;">
            <button type="submit" class="btn-outline btn-inline" style="margin-top:0;">Resend code</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

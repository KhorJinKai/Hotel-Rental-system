@model List<HouseRentalSystem.Models.SupportTicket>
@using HouseRentalSystem.Models
@{
    ViewData["Title"] = "Support inbox";
    var status = ViewBag.Status as TicketStatus?;
    var awaitingOnly = ViewBag.AwaitingOnly is bool a && a;

    string StatusClass(TicketStatus s) => s == TicketStatus.Closed ? "status-neutral" : "status-pending";

    bool AwaitingReply(SupportTicket t)
    {
        var last = t.Messages.OrderByDescending(m => m.SentDate).ThenByDescending(m => m.MessageID).FirstOrDefault();
        return t.Status == TicketStatus.Open && last?.Sender != MessageSender.Admin;
    }
}

<div class="container page-section">

    <div class="results-head">
        <div>
            <h1>Support inbox</h1>
            <span class="result-count">@Model.Count ticket@(Model.Count == 1 ? "" : "s")</span>
        </div>
        <a class="btn-outline" asp-controller="Admin" asp-action="Index">Back to dashboard</a>
    </div>

    <form method="get" asp-controller="Admin" asp-action="Support" style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px; align-items:center;">
        <select name="status" style="min-width:160px;">
            <option value="">All statuses</option>
            @foreach (var s in Enum.GetValues<TicketStatus>())
            {
                <option value="@s" selected="@(status == s)">@s</option>
            }
        </select>
        <label style="display:flex; align-items:center; gap:6px; font-size:13.5px;">
            <input type="checkbox" name="awaitingOnly" value="true" checked="@awaitingOnly" style="width:auto;" />
            Awaiting reply only
        </label>
        <button type="submit" class="btn-outline btn-inline" style="margin-top:0;">Filter</button>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="icon">&#128172;</div>
            <h3>No tickets match this filter</h3>
        </div>
    }

    @foreach (var ticket in Model)
    {
        var last = ticket.Messages.OrderByDescending(m => m.SentDate).ThenByDescending(m => m.MessageID).FirstOrDefault();
        <a class="checkout-card" style="display:block; margin-bottom:14px; text-decoration:none;"
           asp-controller="Support" asp-action="Details" asp-route-id="@ticket.TicketID">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
                <div>
                    <div style="font-size:15px; font-weight:700; color:var(--text-primary);">@ticket.Subject</div>
                    <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                        Ticket #@ticket.TicketID &middot; @ticket.User?.FullName (@ticket.User?.Email)
                    </div>
                </div>
                <div style="display:flex; gap:6px; align-items:flex-start;">
                    @if (AwaitingReply(ticket))
                    {
                        <span class="status-pill status-rejected">Awaiting reply</span>
                    }
                    <span class="status-pill @StatusClass(ticket.Status)">@ticket.Status</span>
                </div>
            </div>
            @if (last != null)
            {
                <p style="margin:10px 0 0; font-size:13px; color:var(--text-secondary); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    @(last.Sender == MessageSender.Admin ? "You: " : last.Sender == MessageSender.Bot ? "Bot: " : "")@last.Body
                </p>
            }
            <div style="margin-top:8px; font-size:11.5px; color:var(--text-muted);">
                Last activity @ticket.LastMessageDate.ToString("d MMM yyyy, h:mm tt")
            </div>
        </a>
    }
</div>

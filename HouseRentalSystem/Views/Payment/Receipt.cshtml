@model HouseRentalSystem.Models.Payment
@using HouseRentalSystem.Services
@using System.Security.Claims
@{
    ViewData["Title"] = "Receipt " + ReceiptService.ReceiptNumber(Model);
    var property = Model.Agreement.Application.Property;
    var tenant = Model.Agreement.Application.Tenant;
    var owner = property.Owner;
    var isTenant = User.IsInRole("Tenant") && User.FindFirstValue(ClaimTypes.NameIdentifier) == tenant.UserID.ToString();
}

<div class="container page-section" style="max-width:640px;">

    <div class="results-head no-print">
        <div>
            <h1>Payment receipt</h1>
            <span class="result-count">@ReceiptService.ReceiptNumber(Model)</span>
        </div>
        <a class="btn-outline" asp-controller="RentalAgreement" asp-action="Details" asp-route-applicationId="@Model.Agreement.ApplicationID">Back to agreement</a>
    </div>

    <div class="checkout-card" id="receiptCard">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; padding-bottom:18px; border-bottom:1px solid var(--border-color);">
            <div>
                <div style="font-size:20px; font-weight:800; color:var(--brand-primary-dark);">RentEasy</div>
                <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">House / Room Rental System</div>
            </div>
            <div style="text-align:right;">
                <div style="font-weight:700;">@ReceiptService.ReceiptNumber(Model)</div>
                <div style="font-size:12px; color:var(--text-muted);">@((Model.PaymentDate ?? Model.DueDate).ToString("d MMM yyyy, h:mm tt"))</div>
            </div>
        </div>

        <div class="price-breakdown" style="border-top:none; padding-top:16px;">
            <div class="row"><span>Property</span><span>@property.Title</span></div>
            <div class="row"><span>Description</span><span>@ReceiptService.Describe(Model)</span></div>
            <div class="row"><span>Paid by</span><span>@tenant.FullName</span></div>
            <div class="row"><span>Paid to</span><span>@owner.FullName</span></div>
            <div class="row"><span>Payment method</span><span>Card via Stripe</span></div>
            <div class="row"><span>Reference</span><span style="font-family:monospace; font-size:12px;">@(Model.ReceiptPath ?? "-")</span></div>
            <div class="row total">
                <span>Amount paid</span>
                <span style="color:var(--accent-value);">RM @Model.Amount.ToString("N2")</span>
            </div>
        </div>

        <p style="font-size:11.5px; color:var(--text-muted); margin-top:18px;">
            This is an automated receipt generated by RentEasy for your records.
        </p>
    </div>

    <div class="no-print" style="display:flex; gap:10px; margin-top:16px; flex-wrap:wrap;">
        <button type="button" class="btn-outline btn-inline" style="margin-top:0;" onclick="window.print()">Print / save as PDF</button>
        @if (isTenant)
        {
            <form asp-controller="Payment" asp-action="ResendReceipt" asp-route-id="@Model.PaymentID" method="post">
                <button type="submit" class="btn-outline btn-inline" style="margin-top:0;">Email me this receipt</button>
            </form>
        }
    </div>
</div>

<style>
    @@media print {
        .site-header, .site-footer, .no-print { display: none !important; }
        #receiptCard { box-shadow: none; border: none; }
    }
</style>
